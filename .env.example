# =====================================================================
#  Copy this file to ".env" for LOCAL development.  (".env" is git-ignored.)
#  On GitHub the same names are set under
#  Settings → Secrets and variables → Actions → Variables.
# =====================================================================

# The Google Apps Script web-app URL (Deploy → Manage deployments → Web app → URL).
# It looks like:  https://script.google.com/macros/s/AKfycb.../exec
# This address is public by design (it ends up in the website's JavaScript):
# visitors can only use the public actions; every admin action needs your password.
NEXT_PUBLIC_API_URL="https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec"

# The public address of the finished website, WITHOUT a trailing slash.
#   user site : https://username.github.io
#   own domain: https://yourdomain.com
#   repo site : https://username.github.io/RepoName
# For LOCAL work use:  http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
